{
  "name": "e-commerce-website",
  "private": true,
  "sideEffects": false,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "shopify hydrogen build",
    "dev": "shopify hydrogen dev",
    "preview": "shopify hydrogen preview --build",
    "lint": "oxlint && node scripts/check-fsd.mjs && node scripts/check-filenames.mjs",
    "lint:fsd": "node scripts/check-fsd.mjs",
    "lint:filenames": "node scripts/check-filenames.mjs",
    "lint:circular": "madge --circular --extensions ts,tsx --ts-config tsconfig.json app/src app/routes server.ts",
    "test": "bun test",
    "typecheck": "react-router typegen && tsc --noEmit",
    "codegen": "shopify hydrogen codegen && react-router typegen",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "check:specs": "node scripts/check-specs.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@reduxjs/toolkit": "^2.12.0",
    "@shopify/hydrogen": "2026.4.5",
    "graphql": "^16.10.0",
    "graphql-tag": "^2.12.6",
    "isbot": "^5.1.22",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-redux": "^9.3.0",
    "react-router": "7.16.0",
    "react-router-dom": "7.16.0"
  },
  "devDependencies": {
    "@fontsource-variable/fredoka": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/anton": "^5.3.0",
    "@fontsource/archivo-black": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@graphql-codegen/cli": "5.0.2",
    "@react-router/dev": "7.16.0",
    "@react-router/fs-routes": "7.16.0",
    "@shopify/cli": "3.93.2",
    "@shopify/hydrogen-codegen": "^0.3.3",
    "@shopify/mini-oxygen": "^4.2.2",
    "@shopify/oxygen-workers-types": "^4.2.0",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "graphql-config": "^5.0.3",
    "madge": "^8.0.0",
    "oxlint": "^1.79.0",
    "prettier": "^3.4.2",
    "typescript": "^5.9.2",
    "vite": "^8.2.1"
  },
  "engines": {
    "node": "^22 || ^24"
  },
  "trustedDependencies": [
    "unrs-resolver"
  ]
}
